# Avand API root, matching REACT_APP_SERVER_ADDRESS in new-avand-frontend
AVAND_BASE_URL=https://your-avand-api.example.com

# Refresh token from an authorized Avand login
AVAND_REFRESH_TOKEN=your-refresh-token

# Business entity for the authorized organization
AVAND_BUSINESS_ENTITY_ID=your-business-entity-id

# Optional initial access token and local proxy port
# AVAND_ACCESS_TOKEN=your-access-token
# AVAND_PROXY_PORT=0
